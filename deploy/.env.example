# MySQL
DB_URL=jdbc:mysql://127.0.0.1:3306/smoke_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=change-me

# Huawei Cloud IoTDA
HUAWEI_IOT_AK=
HUAWEI_IOT_SK=
HUAWEI_IOT_REGION_ID=cn-north-4
HUAWEI_IOT_ENDPOINT=
HUAWEI_IOT_PROJECT_ID=
HUAWEI_IOT_DEVICE_ID=

# AMap Web end (JS API)
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# Optional services
YOLO_SERVICE_URL=http://127.0.0.1:8001/detect
SERVER_PORT=8080
WEB_PORT=80

# ===== 本地 AI 助手（Ollama + Qdrant，全部本地运行，无需真实云端 API Key）=====
# FOREST_LLM_API_KEY 的 "ollama" 只是 OpenAI 兼容协议要求的占位字符串，不是密钥。
FOREST_AI_ENABLED=true
FOREST_LLM_BASE_URL=http://ollama:11434/v1
FOREST_LLM_API_URL=http://ollama:11434/v1/chat/completions
FOREST_LLM_API_KEY=ollama
FOREST_LLM_MODEL=qwen3:4b
FOREST_EMBEDDING_MODEL=qwen3-embedding:0.6b
FOREST_QDRANT_URL=http://qdrant:6333
FOREST_AI_TIMEOUT_SECONDS=120
FOREST_AI_MAX_CONTEXT_MESSAGES=10
FOREST_AI_TOP_K=5
# 本地（非 Docker）开发时改为 http://127.0.0.1:11434/v1 与 http://127.0.0.1:6333，
# 知识目录默认 ../knowledge（以 demo/ 为工作目录）：
# FOREST_KNOWLEDGE_DIR=../knowledge
# FOREST_KNOWLEDGE_UPLOAD_DIR=../knowledge-uploads
